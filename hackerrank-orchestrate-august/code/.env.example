# Copy to .env and fill in as needed. Never commit .env — it is gitignored and
# excluded from the submission archive.
#
# Loaded by main.load_dotenv() at start-up, which never overrides a real export
# and never prints a value. Every variable is optional: the offline path (route,
# and warm-media without --allow-network) makes no network call and needs none
# of them.

# Anthropic credential. Used for image description and, later, the routing call.
# Read by: perception.client.require_credentials().
# Required only for --allow-network.
ANTHROPIC_API_KEY=

# Anthropic model identifier. Recorded in each run's manifest and hashed into
# the image half of the media cache key, so a cached description is always
# attributable to a model. Verify the exact string against GET /v1/models
# rather than assuming one; e.g. claude-sonnet-5.
# Read by: config.load_model_id().
# Required only for --allow-network.
ROUTER_MODEL_ID=

# Sarvam AI credential. Used for voice-note transcription (saaras:v3), which
# does not go through Anthropic: the corpus is code-mixed Indic speech and the
# transcripts must land in the same romanised register as the text channel.
# Read by: perception.client.require_sarvam_credentials().
# Required only for --allow-network.
SARVAM_API_KEY=

# Path to the dataset directory used by the contract tests.
# Read by: tests/test_contract.py. Defaults to ../dataset when unset; those
# tests skip cleanly if no dataset is found, which is why the submission archive
# can exclude it.
ROUTER_DATASET=

# NOTE ON SECRETS
# The three modules named above are the only ones that touch the environment.
# A credential must never appear in a log record, an exception message, a
# traceback, a run manifest, or a committed file.
